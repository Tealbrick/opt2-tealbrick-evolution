# WP1 measurement: the load worker + generator (smoke/measure/load.ts) as a container next to the temporal service
# container. Build context: repository root. Not part of the product images or CI.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
WORKDIR /app
ENV CI=true COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY smoke ./smoke
CMD ["node", "smoke/measure/load.ts"]
